SECRET_KEY=prod-secret-key-change-this-in-vps
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-vps-ip

# Database
DB_ENGINE=POSTGRES
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://app_user:app_password@db:5432/app_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
